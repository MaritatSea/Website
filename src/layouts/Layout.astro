---
import { u } from '../lib/utils';
import '../styles/global.css';
import Waves from '../components/Waves.astro';
import site from '../data/site.json';
import { t, href, routes, langs, type Lang, type Page } from '../i18n';

interface Props {
  lang: Lang;
  /** Welke pagina dit is (voor menu en taalwissel). */
  page?: Page;
  /** Eigen links naar deze pagina in andere talen (bijv. bij nieuwsberichten). */
  alternates?: Partial<Record<Lang, string>>;
  title?: string;
  description?: string;
  image?: string;
}

const { lang, page, title, image = '/images/og-image.jpg' } = Astro.props;
const { ui, home } = t(lang);
const description = Astro.props.description || ui.standaardOmschrijving;

const pageTitle = title ? `${title} | Marit at Sea` : ui.standaardTitel;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(u(image), Astro.site);
const year = new Date().getFullYear();

// Dezelfde pagina in de andere taal; zonder bekende tegenhanger: de homepagina
const alternates: Record<Lang, string> = Object.fromEntries(
  langs.map((l) => [l, Astro.props.alternates?.[l] ?? (page ? href(l, page) : href(l, 'home'))]),
) as Record<Lang, string>;
const other: Lang = lang === 'nl' ? 'en' : 'nl';

const nav: { page: Page; label: string }[] = [
  { page: 'home', label: ui.navHome },
  { page: 'over', label: ui.navOver },
  { page: 'reis', label: ui.navReis },
  { page: 'nieuws', label: ui.navNieuws },
];
---

<!doctype html>
<html lang={lang === 'en' ? 'en-GB' : 'nl'} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l === 'en' ? 'en-GB' : 'nl'} href={new URL(alternates[l], Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.nl, Astro.site)} />
    <link rel="icon" type="image/png" href={u('/favicon.png')} />
    <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#0f2d45" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'nl_NL'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
    {
      lang === 'nl' && (
        <script is:inline define:vars={{ enUrl: alternates.en }}>
          // Apparaat niet op Nederlands ingesteld en nog geen eigen taalkeuze? Dan naar de Engelse versie.
          try {
            var gekozen = localStorage.getItem('taal');
            var bot = navigator.webdriver || /bot|crawl|spider|slurp|preview/i.test(navigator.userAgent);
            if (!gekozen && !bot) {
              var voorkeur = (navigator.languages || [navigator.language || '']).map(function (l) {
                return String(l).toLowerCase().slice(0, 2);
              });
              var eerste = voorkeur.filter(function (l) {
                return l === 'nl' || l === 'en';
              })[0];
              if (voorkeur[0] && eerste !== 'nl') location.replace(enUrl + location.hash);
            }
          } catch (e) {}
        </script>
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">{ui.naarInhoud}</a>

    <header class="site-header" data-header>
      <div class="container header-inner">
        <a href={href(lang, 'home')} class="brand" aria-label={ui.naarHome}>
          <img src={u('/images/logo-badge.webp')} alt="" width="48" height="47" />
          <span class="script">Marit <small>at sea</small></span>
        </a>

        <a class="lang-switch mobile-only" href={alternates[other]} hreflang={other} lang={other} data-taal={other}>
          {other.toUpperCase()}
        </a>

        <button class="menu-toggle" aria-expanded="false" aria-controls="menu" data-menu-toggle>
          <span class="visually-hidden">Menu</span>
          <span class="bars" aria-hidden="true"></span>
        </button>

        <nav id="menu" class="nav" data-menu>
          {
            nav.map((item) => (
              <a href={href(lang, item.page)} aria-current={page === item.page ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <a href={href(lang, 'sponsor')} class="btn btn-primary nav-cta" aria-current={page === 'sponsor' ? 'page' : undefined}>
            {ui.navSponsor}
          </a>
          <a class="lang-switch desktop-only" href={alternates[other]} hreflang={other} lang={other} title={ui.taalWissel} data-taal={other}>
            {other.toUpperCase()}
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-sea">
        <Waves
          colors={['rgba(42,109,151,0.35)', 'rgba(42,109,151,0.55)', 'rgba(23,61,92,0.8)', '#0f2d45']}
          height="clamp(50px, 8vw, 110px)"
        />
        <img class="footer-ship" src={u('/images/thalassa.webp')} alt="" width="120" height="91" loading="lazy" />
      </div>
      <div class="footer-body">
        <div class="container footer-grid">
          <div>
            <p class="script footer-brand">Marit at Sea</p>
            {home.footerTekst && <p>{home.footerTekst}</p>}
          </div>
          <nav class="footer-links" aria-label="Footer">
            {nav.map((item) => <a href={href(lang, item.page)}>{item.label}</a>)}
            <a href={href(lang, 'sponsor')}>{ui.navSponsor}</a>
            {site.organisatieUrl && <a href={site.organisatieUrl}>{site.organisatie}</a>}
            {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
            {site.instagram && <a href={site.instagram}>Instagram</a>}
          </nav>
        </div>
        <div class="container lang-choice" role="group" aria-label="Taal / Language">
          <span class="lang-label" aria-hidden="true">🌐 Taal · Language</span>
          <a href={alternates.nl} hreflang="nl" lang="nl" data-taal="nl" aria-current={lang === 'nl' ? 'true' : undefined}>
            🇳🇱 Nederlands
          </a>
          <a href={alternates.en} hreflang="en-GB" lang="en-GB" data-taal="en" aria-current={lang === 'en' ? 'true' : undefined}>
            🇬🇧 English
          </a>
        </div>
        <p class="container copyright">© {year} Marit at Sea · {ui.voetnootGroet}</p>
      </div>
    </footer>

    <script>
      // Gekozen taal onthouden (gaat voor de taal van het apparaat)
      document.querySelectorAll<HTMLAnchorElement>('[data-taal]').forEach((a) =>
        a.addEventListener('click', () => {
          try {
            localStorage.setItem('taal', a.dataset.taal ?? '');
          } catch {}
        }),
      );

      // Header krijgt achtergrond na scrollen
      const header = document.querySelector<HTMLElement>('[data-header]');
      const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 20);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // Mobiel menu
      const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const menu = document.querySelector<HTMLElement>('[data-menu]');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        menu?.classList.toggle('open', !open);
      });
      menu?.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => {
          toggle?.setAttribute('aria-expanded', 'false');
          menu.classList.remove('open');
        }),
      );

      // Elementen laten verschijnen bij scrollen
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.15 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 0.5rem;
    z-index: 100;
    background: var(--navy);
    color: #fff;
    padding: 0.5rem 1rem;
    border-radius: 8px;
  }

  .skip:focus {
    left: 0.5rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    transition:
      background 0.3s ease,
      box-shadow 0.3s ease;
  }

  .site-header.scrolled {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 20px -10px rgba(15, 45, 69, 0.3);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--navy);
    font-size: 1.6rem;
  }

  .brand img {
    transition: transform 0.6s ease;
  }

  .brand:hover img {
    transform: rotate(-12deg);
  }

  .brand small {
    font-size: 0.7em;
    color: var(--sea);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav a:not(.btn) {
    color: var(--navy);
    text-decoration: none;
    font-weight: 700;
    position: relative;
  }

  .nav a:not(.btn)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 3px;
    border-radius: 3px;
    background: var(--sea-2);
    transform: scaleX(0);
    transition: transform 0.25s ease;
  }

  .nav a:not(.btn):hover::after,
  .nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .nav-cta {
    padding: 0.6em 1.3em;
  }

  .lang-switch {
    display: inline-grid;
    place-items: center;
    min-width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 2px solid var(--navy);
    font-weight: 900;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--navy);
    text-decoration: none;
    transition:
      background 0.2s,
      color 0.2s,
      transform 0.3s;
  }

  .nav a.lang-switch::after {
    display: none;
  }

  .lang-switch:hover {
    background: var(--navy);
    color: #fff;
    transform: rotate(-10deg);
  }

  .mobile-only {
    display: none;
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    cursor: pointer;
    position: relative;
  }

  .bars,
  .bars::before,
  .bars::after {
    position: absolute;
    left: 10px;
    width: 24px;
    height: 3px;
    border-radius: 3px;
    background: var(--navy);
    transition: transform 0.25s ease;
  }

  .bars {
    top: 21px;
  }

  .bars::before,
  .bars::after {
    content: '';
    left: 0;
  }

  .bars::before {
    top: -8px;
  }

  .bars::after {
    top: 8px;
  }

  [aria-expanded='true'] .bars {
    background: transparent;
  }

  [aria-expanded='true'] .bars::before {
    transform: translateY(8px) rotate(45deg);
  }

  [aria-expanded='true'] .bars::after {
    transform: translateY(-8px) rotate(-45deg);
  }

  @media (max-width: 820px) {
    .menu-toggle {
      display: block;
    }

    .mobile-only {
      display: inline-grid;
      margin-left: auto;
      margin-right: 0.5rem;
    }

    .desktop-only {
      display: none;
    }

    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: #fff;
      box-shadow: 0 20px 30px -20px rgba(15, 45, 69, 0.4);
      padding: 0.5rem 1.25rem 1.25rem;
      display: none;
    }

    .nav.open {
      display: flex;
    }

    .nav a:not(.btn) {
      padding: 0.8rem 0;
      border-bottom: 1px solid var(--foam);
    }

    .nav-cta {
      margin-top: 1rem;
      justify-content: center;
    }
  }

  /* Footer */
  .site-footer {
    color: #d6e8ef;
    margin-top: 2rem;
  }

  .footer-sea {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .footer-ship {
    position: absolute;
    bottom: 28%;
    left: 0;
    width: clamp(70px, 9vw, 120px);
    opacity: 0.9;
    z-index: 0;
    animation:
      sail-across 70s linear infinite,
      bob 4s ease-in-out infinite;
  }

  @keyframes sail-across {
    from {
      left: -150px;
    }
    to {
      left: 100%;
    }
  }

  @keyframes bob {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-5px) rotate(2deg);
    }
  }

  .footer-sea :global(.waves) {
    z-index: 1;
  }

  .footer-body {
    background: var(--navy);
    padding: 2rem 0 1.5rem;
  }

  .footer-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
  }

  .footer-brand {
    font-size: 2rem;
    color: #fff;
    margin: 0 0 0.25rem;
  }

  .site-footer a {
    color: #fff;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .lang-choice {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .lang-label {
    font-weight: 700;
    margin-right: 0.4rem;
    opacity: 0.8;
  }

  .lang-choice a {
    padding: 0.35em 1em;
    border-radius: 999px;
    border: 2px solid rgba(255, 255, 255, 0.35);
    font-weight: 800;
    text-decoration: none;
    transition: background 0.2s;
  }

  .lang-choice a:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .lang-choice a[aria-current] {
    background: #fff;
    color: var(--navy);
    border-color: #fff;
  }

  .copyright {
    margin-top: 1.25rem;
    font-size: 0.9rem;
    opacity: 0.7;
  }
</style>
