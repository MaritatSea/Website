---
import '../styles/global.css';
import Waves from '../components/Waves.astro';
import site from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = `Help ${site.naam} aan boord! Zes maanden zeilen én naar school op de ${site.schip}.`,
  image = '/images/og-image.jpg',
} = Astro.props;

const pageTitle = title ? `${title} | Marit at Sea` : 'Marit at Sea | Help mij aan boord!';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const path = Astro.url.pathname;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="nl" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f2d45" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Naar de inhoud</a>

    <header class="site-header" data-header>
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="Marit at Sea, naar de homepagina">
          <img src="/images/logo-badge.webp" alt="" width="48" height="47" />
          <span class="script">Marit <small>at sea</small></span>
        </a>

        <button class="menu-toggle" aria-expanded="false" aria-controls="menu" data-menu-toggle>
          <span class="visually-hidden">Menu</span>
          <span class="bars" aria-hidden="true"></span>
        </button>

        <nav id="menu" class="nav" data-menu>
          <a href="/#over">Over mij</a>
          <a href="/#reis">De reis</a>
          <a href="/#sponsoren">Sponsoren</a>
          <a href="/nieuws/" aria-current={path.startsWith('/nieuws') ? 'page' : undefined}>Nieuws</a>
          <a href="/#sponsor" class="btn btn-primary nav-cta">Sponsor mij</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-sea">
        <Waves
          colors={['rgba(42,109,151,0.35)', 'rgba(42,109,151,0.55)', 'rgba(23,61,92,0.8)', '#0f2d45']}
          height="clamp(50px, 8vw, 110px)"
        />
        <img class="footer-ship" src="/images/thalassa.webp" alt="" width="120" height="91" loading="lazy" />
      </div>
      <div class="footer-body">
        <div class="container footer-grid">
          <div>
            <p class="script footer-brand">Marit at Sea</p>
            {site.footerTekst && <p>{site.footerTekst}</p>}
          </div>
          <nav class="footer-links" aria-label="Footer">
            <a href="/">Home</a>
            <a href="/nieuws/">Nieuws</a>
            <a href="/#sponsor">Sponsor mij</a>
            {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
            {site.instagram && <a href={site.instagram}>Instagram</a>}
          </nav>
        </div>
        <p class="container copyright">© {year} Marit at Sea · Wind in de zeilen! ⛵</p>
      </div>
    </footer>

    <script>
      // Header krijgt achtergrond na scrollen
      const header = document.querySelector<HTMLElement>('[data-header]');
      const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 20);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // Mobiel menu
      const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const menu = document.querySelector<HTMLElement>('[data-menu]');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        menu?.classList.toggle('open', !open);
      });
      menu?.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => {
          toggle?.setAttribute('aria-expanded', 'false');
          menu.classList.remove('open');
        }),
      );

      // Elementen laten verschijnen bij scrollen
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.15 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 0.5rem;
    z-index: 100;
    background: var(--navy);
    color: #fff;
    padding: 0.5rem 1rem;
    border-radius: 8px;
  }

  .skip:focus {
    left: 0.5rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    transition:
      background 0.3s ease,
      box-shadow 0.3s ease;
  }

  .site-header.scrolled {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 20px -10px rgba(15, 45, 69, 0.3);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--navy);
    font-size: 1.6rem;
  }

  .brand img {
    transition: transform 0.6s ease;
  }

  .brand:hover img {
    transform: rotate(-12deg);
  }

  .brand small {
    font-size: 0.7em;
    color: var(--sea);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav a:not(.btn) {
    color: var(--navy);
    text-decoration: none;
    font-weight: 700;
    position: relative;
  }

  .nav a:not(.btn)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 3px;
    border-radius: 3px;
    background: var(--sea-2);
    transform: scaleX(0);
    transition: transform 0.25s ease;
  }

  .nav a:not(.btn):hover::after,
  .nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .nav-cta {
    padding: 0.6em 1.3em;
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    cursor: pointer;
    position: relative;
  }

  .bars,
  .bars::before,
  .bars::after {
    position: absolute;
    left: 10px;
    width: 24px;
    height: 3px;
    border-radius: 3px;
    background: var(--navy);
    transition: transform 0.25s ease;
  }

  .bars {
    top: 21px;
  }

  .bars::before,
  .bars::after {
    content: '';
    left: 0;
  }

  .bars::before {
    top: -8px;
  }

  .bars::after {
    top: 8px;
  }

  [aria-expanded='true'] .bars {
    background: transparent;
  }

  [aria-expanded='true'] .bars::before {
    transform: translateY(8px) rotate(45deg);
  }

  [aria-expanded='true'] .bars::after {
    transform: translateY(-8px) rotate(-45deg);
  }

  @media (max-width: 820px) {
    .menu-toggle {
      display: block;
    }

    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: #fff;
      box-shadow: 0 20px 30px -20px rgba(15, 45, 69, 0.4);
      padding: 0.5rem 1.25rem 1.25rem;
      display: none;
    }

    .nav.open {
      display: flex;
    }

    .nav a:not(.btn) {
      padding: 0.8rem 0;
      border-bottom: 1px solid var(--foam);
    }

    .nav-cta {
      margin-top: 1rem;
      justify-content: center;
    }
  }

  /* Footer */
  .site-footer {
    color: #d6e8ef;
    margin-top: 2rem;
  }

  .footer-sea {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .footer-ship {
    position: absolute;
    bottom: 28%;
    left: 0;
    width: clamp(70px, 9vw, 120px);
    opacity: 0.9;
    z-index: 0;
    animation:
      sail-across 70s linear infinite,
      bob 4s ease-in-out infinite;
  }

  @keyframes sail-across {
    from {
      left: -150px;
    }
    to {
      left: 100%;
    }
  }

  @keyframes bob {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-5px) rotate(2deg);
    }
  }

  .footer-sea :global(.waves) {
    z-index: 1;
  }

  .footer-body {
    background: var(--navy);
    padding: 2rem 0 1.5rem;
  }

  .footer-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
  }

  .footer-brand {
    font-size: 2rem;
    color: #fff;
    margin: 0 0 0.25rem;
  }

  .site-footer a {
    color: #fff;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .copyright {
    margin-top: 2rem;
    font-size: 0.9rem;
    opacity: 0.7;
  }
</style>
