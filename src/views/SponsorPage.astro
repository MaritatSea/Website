---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Waves from '../components/Waves.astro';
import Icon from '../components/Icon.astro';
import Progress from '../components/Progress.astro';
import ClubPortholes from '../components/ClubPortholes.astro';
import SponsorLogos from '../components/SponsorLogos.astro';
import site from '../data/site.json';
import club from '../data/club-van-100.json';
import sponsorData from '../data/sponsors.json';
import { u, fixHtml, excerpt, formatEuro, extUrl } from '../lib/utils';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { sponsor, ui } = t(lang);

const leden = (club.leden as { naam: string; url?: string }[]).filter((l) => l && l.naam);
const hasSponsors = (sponsorData.sponsors ?? []).some((s) => s && (s.naam || s.logo));
const ibanCompact = (site.iban ?? '').replace(/\s+/g, '');
---

<Layout lang={lang} page="sponsor" title={sponsor.titel} description={excerpt(sponsor.intro)} image={sponsor.foto || undefined}>
  <PageHero title={sponsor.titel}>
    <nav class="toc" aria-label={ui.manierenSponsoren}>
      <a href="#gofundme">{sponsor.gofundmeTitel}</a>
      <a href="#club-van-100">{sponsor.clubTitel}</a>
      <a href="#zakelijk">{sponsor.zakelijkTitel}</a>
    </nav>
  </PageHero>

  <!-- Intro + foto -->
  <section class="section intro">
    <div class="container intro-grid">
      <div data-reveal>
        <div class="prose lead" set:html={fixHtml(sponsor.intro)} />
        <Progress lang={lang} light />
      </div>
      {
        sponsor.foto && (
          <div class="photo" data-reveal>
            <img src={u(sponsor.foto)} alt={ui.fotoAanBoordAlt} width="1200" height="1600" />
          </div>
        )
      }
    </div>
  </section>

  <!-- GoFundMe -->
  <section id="gofundme" class="section block alt">
    <div class="container narrow" data-reveal>
      <h2><span class="b-icon"><Icon name="hart" size={30} /></span>{sponsor.gofundmeTitel}</h2>
      <p class="big">{sponsor.gofundmeSamenvatting}</p>
      {
        site.gofundmeUrl ? (
          <a href={site.gofundmeUrl} class="btn btn-primary" target="_blank" rel="noopener">
            {sponsor.gofundmeKnop} →
          </a>
        ) : (
          <p class="soon">{ui.gofundmeBinnenkort}</p>
        )
      }
    </div>
  </section>

  <!-- Club van 100 -->
  <section id="club-van-100" class="section block club">
    <div class="container club-grid">
      <div data-reveal>
        <h2><span class="b-icon wood"><Icon name="vrienden" size={30} /></span>{sponsor.clubTitel}</h2>
        <div class="prose" set:html={fixHtml(sponsor.clubTekst)} />
        {
          site.gofundmeUrl && (
            <a href={site.gofundmeUrl} class="btn btn-primary" target="_blank" rel="noopener">
              {ui.doeMeeGofundme}
            </a>
          )
        }
      </div>
      {
        sponsor.clubFoto && (
          <div class="plank" data-reveal>
            <img src={u(sponsor.clubFoto)} alt={ui.borrelplankAlt} loading="lazy" />
            <span class="stamp">
              <small>{ui.stempelVanaf}</small>{formatEuro(100, lang)}
            </span>
          </div>
        )
      }
    </div>

    <div class="container members" data-reveal>
      <h3>{sponsor.clubLedenTitel}</h3>
      <ClubPortholes lang={lang} />
      {
        leden.length > 0 && (
          <ul class="names">
            {leden.map((l) => (
              <li>
                {extUrl(l.url) ? (
                  <a href={extUrl(l.url)} target="_blank" rel="noopener">
                    {l.naam}
                  </a>
                ) : (
                  l.naam
                )}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <!-- Zakelijk -->
  <section id="zakelijk" class="business">
    <Waves
      colors={['rgba(42,109,151,0.35)', 'rgba(42,109,151,0.55)', 'rgba(23,61,92,0.8)', '#0f2d45']}
      height="clamp(50px, 8vw, 110px)"
    />
    <div class="business-body">
      <div class="container">
        <div class="narrow-l" data-reveal>
          <h2><span class="b-icon light"><Icon name="vlag" size={30} /></span>{sponsor.zakelijkTitel}</h2>
          <div class="prose" set:html={fixHtml(sponsor.zakelijkTekst)} />
        </div>

        <ol class="tiers">
          {
            sponsor.tegenprestaties.map((t, i) => (
              <li class="tier" data-reveal style={`transition-delay:${i * 120}ms`}>
                <div class="flagpole" aria-hidden="true">
                  {Array.from({ length: i + 1 }, (_, k) => (
                    <span class="flag" style={`animation-delay:${-k * 0.3}s`} />
                  ))}
                </div>
                <h3>{t.bedrag}</h3>
                <p>{t.tekst}</p>
              </li>
            ))
          }
        </ol>

        <div class="invoice" data-reveal>
          <h3>{ui.hoeWerktHet}</h3>
          <div class="prose" set:html={fixHtml(sponsor.factuurTekst)} />
          {
            sponsor.contactTekst && (
              <p class="contact">
                <strong>{sponsor.contactTekst}</strong>
                {site.email && (
                  <>
                    {' '}
                    <a href={`mailto:${site.email}`}>{site.email}</a>
                  </>
                )}
              </p>
            )
          }
        </div>
      </div>
    </div>
    <Waves
      flip
      colors={['rgba(42,109,151,0.35)', 'rgba(42,109,151,0.55)', 'rgba(23,61,92,0.8)', '#0f2d45']}
      height="clamp(50px, 8vw, 110px)"
    />
  </section>

  <!-- Direct overmaken (alleen als er een IBAN is ingevuld) -->
  {
    site.iban && (
      <section id="overmaken" class="section">
        <div class="container narrow" data-reveal>
          <div class="card bank">
            <h2>{sponsor.bankTitel}</h2>
            <p>{sponsor.bankTekst}</p>
            <div class="iban-box">
              <span class="iban-label">IBAN</span>
              <span class="iban" data-iban>
                {site.iban}
              </span>
              <button class="copy" type="button" data-copy={ibanCompact} data-done={ui.gekopieerd}>
                {ui.kopieer}
              </button>
            </div>
            <dl>
              {site.tenaamstelling && (
                <>
                  <dt>{ui.ibanTnv}</dt>
                  <dd>{site.tenaamstelling}</dd>
                </>
              )}
              {site.omschrijving && (
                <>
                  <dt>{ui.ibanOmschrijving}</dt>
                  <dd>{site.omschrijving}</dd>
                </>
              )}
            </dl>
          </div>
        </div>
      </section>
    )
  }

  {
    hasSponsors && (
      <section class="section">
        <div class="container">
          <div class="section-title" data-reveal>
            <h2>{ui.mijnSponsoren}</h2>
          </div>
          <SponsorLogos />
        </div>
      </section>
    )
  }
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        const label = btn.textContent;
        btn.textContent = btn.dataset.done ?? '✓';
        btn.classList.add('done');
        setTimeout(() => {
          btn.textContent = label;
          btn.classList.remove('done');
        }, 2000);
      } catch {
        const el = document.querySelector('[data-iban]');
        if (el) getSelection()?.selectAllChildren(el);
      }
    });
  });
</script>

<style>
  .narrow {
    width: min(100% - 2.5rem, 820px);
  }

  .toc {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .toc a {
    background: rgba(255, 255, 255, 0.75);
    border-radius: 999px;
    padding: 0.35em 1em;
    font-weight: 800;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--navy);
  }

  .toc a:hover {
    background: #fff;
  }

  .block h2,
  .business h2 {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .section-title h2 {
    font-family: var(--font-script);
    font-weight: 400;
  }

  .b-icon {
    flex: none;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #fff;
    background: linear-gradient(145deg, var(--sea-2), var(--navy-2));
  }

  .b-icon.wood {
    background: linear-gradient(145deg, #c98f52, var(--wood));
  }

  .b-icon.light {
    background: #fff;
    color: var(--navy);
  }

  /* Intro */
  .intro {
    padding-top: 1.5rem;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .lead {
    font-size: 1.15rem;
    margin-bottom: 1rem;
  }

  .intro :global(.progress) {
    margin: 0;
    max-width: none;
  }

  .photo img {
    display: block;
    width: 100%;
    max-width: 380px;
    margin-inline: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 200px 200px var(--radius) var(--radius);
    box-shadow: var(--shadow);
  }

  /* Blokken */
  .block.alt {
    background: var(--foam);
  }

  .big {
    font-size: 1.2rem;
  }

  .soon {
    font-weight: 700;
    font-style: italic;
    color: var(--muted);
  }

  .club {
    background: linear-gradient(var(--sand), #fff);
  }

  .club-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .plank {
    position: relative;
  }

  .plank img {
    display: block;
    width: 100%;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    rotate: 2deg;
  }

  .stamp {
    position: absolute;
    top: -1.2rem;
    left: -0.8rem;
    width: 92px;
    height: 92px;
    border-radius: 50%;
    display: grid;
    place-content: center;
    text-align: center;
    background: var(--wood);
    color: #fff;
    font-weight: 900;
    font-size: 1.15rem;
    line-height: 1.1;
    border: 3px dashed rgba(255, 255, 255, 0.7);
    outline: 4px solid var(--wood);
    rotate: -12deg;
    box-shadow: var(--shadow);
    animation: wobble 5s ease-in-out infinite;
  }

  .stamp small {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  @keyframes wobble {
    50% {
      transform: rotate(8deg) scale(1.05);
    }
  }

  .members {
    margin-top: 3.5rem;
    text-align: center;
  }

  .members h3 {
    font-size: 1.4rem;
  }

  .names {
    list-style: none;
    padding: 0;
    margin: 1.5rem auto 0;
    max-width: 820px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .names a {
    color: var(--sea);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .names li {
    background: #fff;
    border: 2px solid #ecd9bf;
    border-radius: 999px;
    padding: 0.3em 0.9em;
    font-weight: 700;
  }

  @media (max-width: 760px) {
    .intro-grid,
    .club-grid {
      grid-template-columns: 1fr;
    }

    .photo img {
      max-width: 280px;
    }
  }

  /* Zakelijk */
  .business-body {
    background: var(--navy);
    color: #e3f0f5;
    padding: clamp(1.5rem, 4vw, 3rem) 0;
  }

  .business h2,
  .business h3 {
    color: #fff;
  }

  .narrow-l {
    max-width: 760px;
  }

  .tiers {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .tier {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .tier h3 {
    font-size: 1.3rem;
    margin-bottom: 0.4rem;
  }

  .tier p {
    margin: 0;
  }

  .flagpole {
    position: relative;
    height: 64px;
    display: flex;
    gap: 1.25rem;
    margin-bottom: 1rem;
  }

  .flag {
    position: relative;
    width: 4px;
    height: 64px;
    background: #cfe3ec;
    border-radius: 2px;
  }

  .flag::after {
    content: '';
    position: absolute;
    left: 4px;
    top: 2px;
    width: 34px;
    height: 22px;
    background: linear-gradient(90deg, #f05a28, #ff8a4c);
    border-radius: 0 4px 4px 0;
    transform-origin: left center;
    animation: wave-flag 1.6s ease-in-out infinite;
    animation-delay: inherit;
  }

  @keyframes wave-flag {
    0%,
    100% {
      transform: skewY(0deg) scaleX(1);
    }
    25% {
      transform: skewY(-8deg) scaleX(0.92);
    }
    75% {
      transform: skewY(6deg) scaleX(0.96);
    }
  }

  .invoice {
    background: rgba(255, 255, 255, 0.07);
    border-radius: var(--radius);
    padding: 1.75rem;
    max-width: 860px;
  }

  .contact a {
    color: #fff;
  }

  /* Overmaken */
  .iban-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    background: var(--foam);
    border: 2px dashed var(--sea-2);
    border-radius: 14px;
    padding: 1rem 1.1rem;
    margin: 0.5rem 0 1.25rem;
  }

  .iban-label {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--sea);
    width: 100%;
  }

  .iban {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: clamp(1rem, 4.2vw, 1.3rem);
    font-weight: 700;
    color: var(--navy);
    white-space: nowrap;
    flex: 1;
    user-select: all;
  }

  .copy {
    font: inherit;
    font-weight: 800;
    font-size: 0.9rem;
    border: 0;
    border-radius: 999px;
    padding: 0.5em 1.1em;
    background: var(--navy);
    color: #fff;
    cursor: pointer;
  }

  .copy.done {
    background: #3f8a4d;
  }

  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.35rem 1rem;
    margin: 0;
  }

  dt {
    color: var(--muted);
  }

  dd {
    margin: 0;
    font-weight: 700;
  }
</style>
