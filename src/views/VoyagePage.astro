---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import RouteMap from '../components/RouteMap.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
import { slugify, u, fixHtml } from '../lib/utils';
import { t, href, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { reis, ui } = t(lang);
---

<Layout lang={lang} page="reis" title={reis.titel} description={reis.intro}>
  <PageHero title={reis.titel} intro={reis.intro}>
    <nav class="toc" aria-label={ui.opDezePagina}>
      {reis.onderdelen.map((o) => <a href={`#${slugify(o.titel)}`}>{o.titel}</a>)}
    </nav>
  </PageHero>

  <section class="section map-section">
    <div class="container narrow">
      <RouteMap lang={lang} voetnoot={reis.kaartVoetnoot} />
    </div>
  </section>

  {
    reis.onderdelen.map((o, i) => (
      <section id={slugify(o.titel)} class:list={['section', 'part', { alt: i % 2 === 1 }]}>
        <div class:list={['container', 'part-grid', { 'has-img': o.afbeelding }]}>
          <div class="part-text" data-reveal>
            <h2>
              <span class="p-icon">
                <Icon name={o.icoon} size={30} />
              </span>
              {o.titel}
            </h2>
            <div class="prose" set:html={fixHtml(o.tekst)} />
          </div>
          {o.afbeelding && (
            <div class="part-img" data-reveal>
              <img src={u(o.afbeelding)} alt="" loading="lazy" />
            </div>
          )}
        </div>
      </section>
    ))
  }

  <section class="section">
    <div class="container narrow follow" data-reveal>
      <h2 class="script">{ui.volgReisTitel}</h2>
      <p>{reis.meerInfoTekst}</p>
      <div class="follow-actions">
        {
          site.schipVolgenUrl && (
            <a href={site.schipVolgenUrl} class="btn btn-primary" target="_blank" rel="noopener">
              📍 {ui.volgSchipLive}
            </a>
          )
        }
        {
          site.organisatieUrl && (
            <a href={site.organisatieUrl} class="btn btn-ghost" target="_blank" rel="noopener">
              {ui.websiteOrganisatie}
            </a>
          )
        }
        <a href={href(lang, 'sponsor')} class="btn btn-ghost">{ui.navSponsor}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .narrow {
    width: min(100% - 2.5rem, 900px);
  }

  .toc {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .toc a {
    background: rgba(255, 255, 255, 0.75);
    border-radius: 999px;
    padding: 0.35em 1em;
    font-weight: 800;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--navy);
    transition: background 0.2s;
  }

  .toc a:hover {
    background: #fff;
  }

  .map-section {
    padding-top: 1rem;
  }

  .part {
    padding: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .part.alt {
    background: var(--foam);
  }

  .part-grid {
    max-width: 820px;
  }

  .part-grid.has-img {
    max-width: var(--max);
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .part.alt .part-grid.has-img .part-img {
    order: -1;
  }

  h2 {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .p-icon {
    flex: none;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #fff;
    background: linear-gradient(145deg, var(--sea-2), var(--navy-2));
  }

  .part-img img {
    display: block;
    width: 100%;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .follow {
    text-align: center;
  }

  .follow h2 {
    display: block;
    font-weight: 400;
  }

  .follow-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 760px) {
    .part-grid.has-img {
      grid-template-columns: 1fr;
    }

    .part.alt .part-grid.has-img .part-img {
      order: 0;
    }
  }
</style>
