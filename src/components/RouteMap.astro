---
import { u } from '../lib/utils';
import { t, type Lang } from '../i18n';

/**
 * Routekaart met een bootje dat de route afvaart. Coördinaten in pixels van
 * de kaart (1024 × 682). Het pad en de havens zijn uit de oranje stippellijn
 * en bolletjes op de kaart zelf gehaald.
 */
interface Props {
  lang: Lang;
  voetnoot?: string | null;
}

const { lang, voetnoot } = Astro.props;
const { ui } = t(lang);

const havens = [
  { naam: ui.havenNederland, x: 876, y: 135, lx: 18, ly: -12, anchor: 'start', ping: false },
  { naam: ui.havenTenerife, x: 707, y: 378.5, lx: 16, ly: 6, anchor: 'start', ping: true },
  { naam: ui.havenDominica, x: 326.8, y: 490.1, lx: 12, ly: -14, anchor: 'start', ping: true },
  { naam: ui.havenCuracao, x: 260, y: 516.6, lx: 4, ly: 30, anchor: 'middle', ping: true },
  { naam: ui.havenPanama, x: 175, y: 539.8, lx: -10, ly: 30, anchor: 'middle', ping: true },
  { naam: ui.havenCuba, x: 170.1, y: 428.7, lx: 14, ly: -14, anchor: 'start', ping: true },
  { naam: ui.havenBermuda, x: 330.5, y: 313.6, lx: 0, ly: -18, anchor: 'middle', ping: true },
  { naam: ui.havenAzoren, x: 617.5, y: 275.6, lx: 0, ly: -18, anchor: 'middle', ping: true },
];

// Punten langs de gestippelde route (in vaarvolgorde)
const pts: [number, number][] = [
  [861.5, 146], [847.9, 147.5], [839.7, 149], [832.6, 152.2], [823.3, 156], [813.3, 159], [803.5, 162.1],
  [796.2, 165.1], [788.1, 168.7], [781.8, 171.8], [773.5, 177.6], [766.5, 185.2], [760.8, 193.8],
  [756.1, 202.7], [752.3, 212.3], [749, 222], [746.3, 231.7], [743.6, 241.7], [741.1, 251.6], [738.5, 261.5],
  [736.3, 271.6], [734, 281.4], [731.7, 291.3], [729.5, 301.4], [727, 311.4], [724.9, 321.4], [722.4, 331.3],
  [719.9, 341.3], [717.4, 351], [714.5, 360.9], [712, 367.7], [707, 378.5], [702.8, 384.4], [697.3, 391.7],
  [690, 398.7], [681.7, 404.9], [673.4, 410.6], [664.5, 415.8], [655.5, 420.5], [646.4, 425.3],
  [637.1, 429.6], [627.7, 433.7], [618.4, 437.7], [608.9, 441.6], [599.3, 445.3], [589.7, 448.8],
  [580, 452.3], [570.3, 455.4], [560.5, 458.6], [550.7, 461.6], [540.9, 464.5], [531, 467.4], [521.3, 470],
  [511.3, 472.6], [501.4, 475], [491.4, 477.5], [481.3, 479.7], [471.3, 481.7], [461.3, 483.7], [451, 485.5],
  [441.2, 487.2], [431, 488.7], [420.8, 490.1], [410.7, 491.3], [400.5, 492.1], [390.4, 493], [380.1, 493.6],
  [369.8, 493.7], [359.5, 493.5], [349.4, 493.1], [338.8, 492.1], [326.8, 490.1], [316, 487.2], [305.8, 488],
  [297.8, 493.9], [290.9, 501.5], [282.7, 507.5], [273.3, 511.3], [265.4, 514.1], [254.6, 513.7],
  [246.6, 511.1], [236.5, 510.5], [226.4, 511.1], [216.3, 513.2], [206.5, 516.4], [197.4, 520.8],
  [188.9, 526.5], [183.4, 531.2], [175, 539.8], [170.8, 533.6], [166.5, 525.6], [164.7, 515.7],
  [165.1, 505.4], [166.7, 495.3], [168.7, 485.3], [171, 475.4], [173.3, 465.3], [175.1, 455.3],
  [175.2, 445.1], [172.4, 434], [165.4, 432.6], [158.2, 437.1], [148.5, 440.5], [138.4, 441.8], [128.9, 439],
  [123.2, 431.3], [125.3, 421.8], [132.9, 415.6], [142.7, 413.2], [152.9, 412.7], [163.2, 411.9],
  [172.6, 408.7], [178.4, 400.8], [181, 391], [184.4, 381.4], [189.3, 372.3], [195.4, 364.1], [202.7, 357.2],
  [208.4, 353.1], [217.4, 348.3], [226.9, 344.5], [236.6, 341.5], [246.4, 338.9], [256.4, 336.5],
  [266.4, 334.1], [276.4, 331.9], [286.4, 329.5], [296.3, 326.7], [305.9, 323.6], [315.5, 320.1],
  [323.9, 316.6], [330.5, 313.6], [337.3, 310.2], [345.8, 306.2], [355.3, 302.2], [364.7, 298.5],
  [374.4, 295.4], [384.3, 292.6], [394.3, 290.4], [404.4, 288.6], [414.6, 287.4], [424.7, 286.7],
  [435, 286.5], [445.3, 286.6], [455.4, 287.3], [465.7, 288.5], [475.7, 290], [485.7, 291.8], [495.9, 293.6],
  [506, 295.5], [516.1, 296.6], [526.3, 297.7], [536.6, 298.4], [546.9, 298.5], [557, 298.3], [567.3, 297.3],
  [577.3, 295.7], [587.3, 293.4], [596.9, 289.9], [606.1, 285.3], [612.8, 280.1], [622.4, 270.1],
  [628.8, 263.3], [636.1, 256.1], [643.6, 249.1], [651.4, 242.6], [659.3, 236.4], [667.5, 230],
  [675.8, 224.2], [684.4, 218.5], [692.9, 213], [701.7, 207.7], [710.5, 202.6], [719.6, 197.9],
  [728.6, 193.1], [737.9, 188.8], [747.1, 184.6], [756.6, 180.7], [766.3, 177.1], [781.2, 171.2],
  [803, 162.2], [828.3, 151.6], [844, 144.4], [852.5, 138.7], [860, 138.2],
];

// Vloeiende lijn door alle punten (Catmull-Rom → Bézier)
const f = (n: number) => +n.toFixed(1);
let d = `M${pts[0][0]} ${pts[0][1]}`;
for (let i = 0; i < pts.length - 1; i++) {
  const p0 = pts[Math.max(0, i - 1)];
  const [p1, p2] = [pts[i], pts[i + 1]];
  const p3 = pts[Math.min(pts.length - 1, i + 2)];
  const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
  const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
  d += `C${f(c1[0])} ${f(c1[1])} ${f(c2[0])} ${f(c2[1])} ${f(p2[0])} ${f(p2[1])}`;
}
const pathId = `route-${lang}-${Math.random().toString(36).slice(2, 7)}`;
---

<figure class="route" data-reveal>
  <div class="map">
    <img src={u('/images/routekaart.webp')} alt={ui.kaartAlt} width="1024" height="682" loading="lazy" />
    <svg viewBox="0 0 1024 682" aria-hidden="true" data-route-svg>
      <path id={pathId} d={d} fill="none" stroke="none"></path>
      {
        havens.map((h, i) => (
          <g class="haven">
            {h.ping && (
              <circle class="ping" cx={h.x} cy={h.y} r="7" style={`transform-origin:${h.x}px ${h.y}px;animation-delay:${i * 0.4}s`} />
            )}
            <text x={h.x + h.lx} y={h.y + h.ly} text-anchor={h.anchor}>
              {h.naam}
            </text>
          </g>
        ))
      }
      <g class="boat">
        <g transform="translate(-14 -28)">
          <path d="M14 2v22" stroke="#0f2d45" stroke-width="2"></path>
          <path d="M15.5 3l10 17h-10z" fill="#fff" stroke="#0f2d45" stroke-width="1.6" stroke-linejoin="round"></path>
          <path d="M12.5 6 5 20h7.5z" fill="#fff" stroke="#0f2d45" stroke-width="1.6" stroke-linejoin="round"></path>
          <path d="M1 24h26l-4 6H5z" fill="#0f2d45"></path>
        </g>
        <animateMotion dur="50s" repeatCount="indefinite" calcMode="paced">
          <mpath href={`#${pathId}`}></mpath>
        </animateMotion>
      </g>
    </svg>
  </div>
  <figcaption>
    <span class="stops">{havens.map((h) => h.naam).concat(ui.havenNederland).join(' → ')}</span>
    {voetnoot && <small>* {voetnoot}</small>}
  </figcaption>
</figure>

<script>
  // Geen bewegend bootje voor wie minder beweging wil
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<SVGSVGElement>('[data-route-svg]').forEach((s) => s.pauseAnimations());
  }
</script>

<style>
  .route {
    margin: 0;
  }

  .map {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    line-height: 0;
  }

  .map img {
    width: 100%;
    display: block;
  }

  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ping {
    fill: #ed551b;
    opacity: 0;
    transform-box: view-box;
    animation: ping 3.2s ease-out infinite;
  }

  @keyframes ping {
    0% {
      opacity: 0.6;
      transform: scale(0.6);
    }
    100% {
      opacity: 0;
      transform: scale(2.6);
    }
  }

  text {
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 800;
    fill: var(--navy);
    paint-order: stroke;
    stroke: rgba(255, 255, 255, 0.85);
    stroke-width: 5px;
    stroke-linejoin: round;
  }

  .boat {
    filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.25));
  }

  figcaption {
    margin-top: 0.9rem;
    text-align: center;
    color: var(--muted);
  }

  .stops {
    display: block;
    font-weight: 700;
    color: var(--navy);
  }

  small {
    display: block;
    margin-top: 0.3rem;
    font-style: italic;
  }

  @media (max-width: 640px) {
    text {
      display: none;
    }
  }
</style>
