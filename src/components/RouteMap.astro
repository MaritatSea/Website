---
import { u } from '../lib/utils';

/** Routekaart met een bootje dat de route afvaart. Coördinaten in kaart-pixels (1000 × 666). */
interface Props {
  voetnoot?: string | null;
}

const { voetnoot } = Astro.props;

const havens = [
  { naam: 'Nederland', x: 848, y: 140, lx: 18, ly: -14, anchor: 'start' },
  { naam: 'Tenerife', x: 690, y: 370, lx: 16, ly: 6, anchor: 'start' },
  { naam: 'Dominica', x: 318, y: 480, lx: 10, ly: -14, anchor: 'start' },
  { naam: 'Curaçao', x: 255, y: 505, lx: 4, ly: 28, anchor: 'middle' },
  { naam: 'Panama', x: 172, y: 527, lx: -10, ly: 28, anchor: 'middle' },
  { naam: 'Cuba', x: 165, y: 420, lx: 10, ly: -14, anchor: 'start' },
  { naam: 'Bermuda', x: 322, y: 307, lx: 0, ly: -16, anchor: 'middle' },
  { naam: 'Azoren', x: 603, y: 270, lx: 0, ly: -16, anchor: 'middle' },
];

// Punten langs de gestippelde route op de kaart (in vaarvolgorde)
const pts: [number, number][] = [
  [848, 140], [800, 148], [748, 188], [726, 240], [712, 295], [698, 345], [690, 370], [600, 420], [470, 455], [380, 475],
  [318, 480], [295, 485], [272, 503], [255, 505], [225, 500], [195, 510], [172, 527], [160, 490],
  [162, 450], [165, 420], [140, 418], [118, 425], [115, 410], [150, 375], [210, 345], [270, 322],
  [322, 307], [420, 290], [520, 288], [603, 270], [672, 205], [750, 160], [800, 146], [848, 140],
];

// Vloeiende lijn door alle punten (Catmull-Rom → Bézier)
const f = (n: number) => n.toFixed(1);
let d = `M${pts[0][0]} ${pts[0][1]}`;
for (let i = 0; i < pts.length - 1; i++) {
  const p0 = pts[Math.max(0, i - 1)];
  const [p1, p2] = [pts[i], pts[i + 1]];
  const p3 = pts[Math.min(pts.length - 1, i + 2)];
  const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
  const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
  d += ` C${f(c1[0])} ${f(c1[1])} ${f(c2[0])} ${f(c2[1])} ${f(p2[0])} ${f(p2[1])}`;
}
---

<figure class="route" data-reveal>
  <div class="map">
    <img src={u('/images/routekaart.webp')} alt="Kaart van de route over de Atlantische Oceaan" width="1024" height="682" loading="lazy" />
    <svg viewBox="0 0 1000 666" aria-hidden="true" data-route-svg>
      <path id="route-pad" d={d} fill="none" stroke="none"></path>
      {
        havens.map((h, i) => (
          <g class="haven">
            <circle class="ping" cx={h.x} cy={h.y} r="9" style={`animation-delay:${i * 0.4}s`} />
            <text x={h.x + h.lx} y={h.y + h.ly} text-anchor={h.anchor}>
              {h.naam}
            </text>
          </g>
        ))
      }
      <g class="boat">
        <g transform="translate(-14 -30)">
          <path d="M14 2v22" stroke="#0f2d45" stroke-width="2" />
          <path d="M15.5 3l10 17h-10z" fill="#fff" stroke="#0f2d45" stroke-width="1.6" stroke-linejoin="round" />
          <path d="M12.5 6 5 20h7.5z" fill="#fff" stroke="#0f2d45" stroke-width="1.6" stroke-linejoin="round" />
          <path d="M1 24h26l-4 6H5z" fill="#0f2d45" />
        </g>
        <animateMotion dur="45s" repeatCount="indefinite" calcMode="linear">
          <mpath href="#route-pad"></mpath>
        </animateMotion>
      </g>
    </svg>
  </div>
  <figcaption>
    <span class="stops">{havens.map((h) => h.naam).concat('Nederland').join(' → ')}</span>
    {voetnoot && <small>* {voetnoot}</small>}
  </figcaption>
</figure>

<script>
  // Geen bewegend bootje voor wie minder beweging wil
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<SVGSVGElement>('[data-route-svg]').forEach((s) => s.pauseAnimations());
  }
</script>

<style>
  .route {
    margin: 0;
  }

  .map {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    line-height: 0;
  }

  .map img {
    width: 100%;
    display: block;
  }

  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ping {
    fill: #f05a28;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: ping 3.2s ease-out infinite;
  }

  @keyframes ping {
    0% {
      opacity: 0.6;
      transform: scale(0.6);
    }
    100% {
      opacity: 0;
      transform: scale(2.6);
    }
  }

  text {
    font-family: var(--font-body);
    font-size: 19px;
    font-weight: 800;
    fill: var(--navy);
    paint-order: stroke;
    stroke: rgba(255, 255, 255, 0.85);
    stroke-width: 5px;
    stroke-linejoin: round;
  }

  .boat {
    filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.25));
  }

  figcaption {
    margin-top: 0.9rem;
    text-align: center;
    color: var(--muted);
  }

  .stops {
    display: block;
    font-weight: 700;
    color: var(--navy);
  }

  small {
    display: block;
    margin-top: 0.3rem;
    font-style: italic;
  }

  @media (max-width: 640px) {
    text {
      display: none;
    }
  }
</style>
