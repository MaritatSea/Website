---
import type { CollectionEntry } from 'astro:content';
import { formatDate, excerpt, u } from '../lib/utils';

interface Props {
  post: CollectionEntry<'nieuws'>;
}

const { post } = Astro.props;
const { title, date, cover, samenvatting } = post.data;
const summary = samenvatting || excerpt(post.body ?? '');
---

<article class="news-card" data-reveal>
  <a href={u(`/nieuws/${post.id}/`)} class="news-link">
    <div class="news-img">
      {
        cover ? (
          <img src={u(cover)} alt="" loading="lazy" />
        ) : (
          <div class="news-placeholder" aria-hidden="true">
            <img src={u('/images/thalassa.webp')} alt="" loading="lazy" />
          </div>
        )
      }
    </div>
    <div class="news-body">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <h3>{title}</h3>
      {summary && <p>{summary}</p>}
      <span class="more">Lees verder <span aria-hidden="true">→</span></span>
    </div>
  </a>
</article>

<style>
  .news-card {
    background: #fff;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: transform 0.25s ease;
  }

  .news-card:hover {
    transform: translateY(-6px) rotate(-0.4deg);
  }

  .news-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .news-img {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--sky);
  }

  .news-img > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .news-card:hover .news-img > img {
    transform: scale(1.05);
  }

  .news-placeholder {
    height: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(var(--sky), var(--foam));
  }

  .news-placeholder img {
    width: 60%;
    opacity: 0.7;
  }

  .news-body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  time {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--sea);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  h3 {
    margin: 0.3rem 0 0.5rem;
    font-size: 1.3rem;
  }

  p {
    color: var(--muted);
    margin: 0 0 1rem;
  }

  .more {
    margin-top: auto;
    font-weight: 800;
    color: var(--sea);
  }
</style>
