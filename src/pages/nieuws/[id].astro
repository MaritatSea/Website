---
import NewsPost from '../../views/NewsPost.astro';
import { getNews } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = await getNews('nl');
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}
---

<NewsPost lang="nl" {...Astro.props} />
