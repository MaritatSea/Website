---
import Layout from '../layouts/Layout.astro';
import Waves from '../components/Waves.astro';
import Icon from '../components/Icon.astro';
import NewsCard from '../components/NewsCard.astro';
import site from '../data/site.json';
import home from '../data/home.json';
import sponsorData from '../data/sponsors.json';
import { formatEuro, getNews } from '../lib/utils';

const news = (await getNews()).slice(0, 3);
const sponsors = (sponsorData.sponsors ?? []).filter((s) => s && (s.naam || s.logo));

const goal = Number(site.doelbedrag) || 0;
const raised = Number(site.opgehaald) || 0;
const pct = goal > 0 ? Math.min(100, Math.round((raised / goal) * 100)) : 0;
const ibanCompact = (site.iban ?? '').replace(/\s+/g, '');
---

<Layout>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="sky" aria-hidden="true">
      <div class="sun"></div>
      <div class="cloud c1"></div>
      <div class="cloud c2"></div>
      <div class="cloud c3"></div>
      <svg class="gulls" viewBox="0 0 200 80">
        <g class="gull g1"><path d="M0 10 Q 8 0 16 10 Q 24 0 32 10" /></g>
        <g class="gull g2"><path d="M60 30 Q 66 22 72 30 Q 78 22 84 30" /></g>
        <g class="gull g3"><path d="M120 6 Q 125 0 130 6 Q 135 0 140 6" /></g>
      </svg>
    </div>

    <div class="container hero-grid">
      <div class="hero-text">
        {home.heroLabel && <p class="eyebrow">{home.heroLabel}</p>}
        <h1><span class="script">Marit</span> <span class="at-sea">at sea</span></h1>
        <p class="tagline">{home.heroTagline}</p>
        <p class="intro">{home.heroIntro}</p>
        <div class="hero-actions">
          <a href="#sponsor" class="btn btn-primary">
            <Icon name="hart" size={22} /> {home.heroKnopSponsor}
          </a>
          <a href="/nieuws/" class="btn btn-ghost">{home.heroKnopNieuws}</a>
        </div>
        <p
          class="countdown"
          data-countdown
          data-start={site.vertrekdatum || undefined}
          data-end={site.terugkomstdatum || undefined}
          hidden
        >
        </p>
      </div>

      <div class="hero-ship">
        <img
          class="ship"
          src="/images/thalassa.webp"
          alt={`Tekening van de ${site.schip}, het zeilschip waarmee ik de reis maak`}
          width="1400"
          height="1058"
          fetchpriority="high"
        />
      </div>
    </div>

    <Waves
      class="hero-waves"
      colors={['rgba(74,143,184,0.45)', 'rgba(42,109,151,0.5)', 'rgba(23,61,92,0.55)', '#ffffff']}
      height="clamp(80px, 13vw, 180px)"
    />
  </section>

  <!-- ============ OVER MIJ ============ -->
  <section id="over" class="section about">
    <div class="container about-grid">
      <div class="about-text" data-reveal>
        <h2 class="script">{home.overTitel}</h2>
        <div class="prose" set:html={home.overTekst} />
      </div>
      <div class="about-logo" data-reveal>
        <img src="/images/logo-marit-at-sea.webp" alt="Logo Marit at Sea" width="900" height="888" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ============ DE REIS ============ -->
  <section id="reis" class="section journey">
    <Waves
      class="wave-top"
      colors={['rgba(193,223,230,0.5)', 'rgba(193,223,230,0.7)', 'rgba(234,245,248,0.9)', '#eaf5f8']}
      height="clamp(40px, 6vw, 80px)"
    />
    <div class="container">
      <div class="section-title" data-reveal>
        <h2>{home.reisTitel}</h2>
        {home.reisSubtitel && <p>{home.reisSubtitel}</p>}
      </div>
      <div class="journey-grid">
        {
          home.reisPunten.map((p, i) => (
            <div class="card journey-card" data-reveal style={`transition-delay:${i * 100}ms`}>
              <div class="journey-icon">
                <Icon name={p.icoon} size={44} />
              </div>
              <h3>{p.titel}</h3>
              <p>{p.tekst}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ SPONSOREN ============ -->
  <section id="sponsor" class="section donate">
    <Waves
      class="wave-top"
      colors={['rgba(42,109,151,0.35)', 'rgba(42,109,151,0.55)', 'rgba(23,61,92,0.8)', '#0f2d45']}
      height="clamp(50px, 8vw, 110px)"
    />
    <div class="container">
      <div class="section-title light" data-reveal>
        <h2>{home.sponsorTitel}</h2>
        <div class="prose" set:html={home.sponsorTekst} />
      </div>

      {
        goal > 0 && (
          <div class="progress" data-reveal data-progress style={`--pct:${pct}`}>
            <div class="progress-labels">
              <span>
                <strong>{formatEuro(raised)}</strong> opgehaald
              </span>
              <span>
                doel: <strong>{formatEuro(goal)}</strong>
              </span>
            </div>
            <div
              class="track"
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow={pct}
              aria-label="Opgehaald bedrag"
            >
              <div class="fill" />
              <svg class="boat" viewBox="0 0 48 48" aria-hidden="true">
                <path d="M24 4v30" stroke="#eaf5f8" stroke-width="2.5" />
                <path d="M26 6l14 24H26z" fill="#fff" stroke="#0f2d45" stroke-width="2" stroke-linejoin="round" />
                <path d="M22 10 11 30h11z" fill="#eaf5f8" stroke="#0f2d45" stroke-width="2" stroke-linejoin="round" />
                <path d="M5 34h38l-6 8H11z" fill="#4a8fb8" stroke="#eaf5f8" stroke-width="1.5" stroke-linejoin="round" />
              </svg>
            </div>
            <p class="pct">{pct}% van de reis bij elkaar gezeild!</p>
          </div>
        )
      }

      <div class="donate-grid">
        <div class="card bank" data-reveal>
          <h3>{home.bankTitel}</h3>
          <p>{home.bankTekst}</p>
          <div class="iban-box">
            <span class="iban-label">IBAN</span>
            <span class="iban" data-iban>{site.iban}</span>
            <button class="copy" type="button" data-copy={ibanCompact}>Kopieer</button>
          </div>
          <dl>
            <dt>Ten name van</dt>
            <dd>{site.tenaamstelling}</dd>
            <dt>Omschrijving</dt>
            <dd>{site.omschrijving}</dd>
          </dl>
          {
            site.betaalverzoekUrl && (
              <a class="btn btn-primary" href={site.betaalverzoekUrl} target="_blank" rel="noopener">
                Betaal via betaalverzoek
              </a>
            )
          }
          {home.bankBedankje && <p class="small">{home.bankBedankje}</p>}
        </div>

        <div class="card plank" data-reveal>
          <div class="plank-img">
            {home.borrelplankFoto && (
              <img src={home.borrelplankFoto} alt="Eikenhouten borrelplank met een gravure van de Thalassa" loading="lazy" />
            )}
            <span class="stamp">
              <small>vanaf</small>
              {formatEuro(Number(home.borrelplankVanaf) || 100)}
            </span>
          </div>
          <h3>{home.borrelplankTitel}</h3>
          <div class="prose" set:html={home.borrelplankTekst} />
        </div>
      </div>
    </div>
    <Waves
      flip
      colors={['rgba(42,109,151,0.35)', 'rgba(42,109,151,0.55)', 'rgba(23,61,92,0.8)', '#0f2d45']}
      height="clamp(50px, 8vw, 110px)"
      class="wave-bottom"
    />
  </section>

  <!-- ============ SPONSORLOGO'S ============ -->
  {
    sponsors.length > 0 && (
      <section id="sponsoren" class="section sponsors">
        <div class="container">
          <div class="section-title" data-reveal>
            <h2>{home.sponsorsTitel}</h2>
            <p>{home.sponsorsTekst}</p>
          </div>
          <ul class="sponsor-grid">
            {sponsors.map((s, i) => {
              const inner = s.logo ? (
                <img src={s.logo} alt={s.naam} loading="lazy" />
              ) : (
                <span class="sponsor-name">{s.naam}</span>
              );
              return (
                <li data-reveal style={`transition-delay:${i * 80}ms`}>
                  {s.url ? (
                    <a href={s.url} target="_blank" rel="noopener" title={s.naam}>
                      {inner}
                    </a>
                  ) : (
                    <div title={s.naam}>{inner}</div>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )
  }

  <!-- ============ NIEUWS ============ -->
  {
    news.length > 0 && (
      <section class="section latest">
        <div class="container">
          <div class="section-title" data-reveal>
            <h2>{home.nieuwsTitel}</h2>
            {home.nieuwsSubtitel && <p>{home.nieuwsSubtitel}</p>}
          </div>
          <div class="news-grid">
            {news.map((post) => (
              <NewsCard post={post} />
            ))}
          </div>
          <p class="center">
            <a href="/nieuws/" class="btn btn-ghost">
              Alle berichten
            </a>
          </p>
        </div>
      </section>
    )
  }
</Layout>

<script>
  // IBAN kopiëren
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.textContent = 'Gekopieerd! ✓';
        btn.classList.add('done');
        setTimeout(() => {
          btn.textContent = 'Kopieer';
          btn.classList.remove('done');
        }, 2000);
      } catch {
        const range = document.createRange();
        const el = document.querySelector('[data-iban]');
        if (el) {
          range.selectNodeContents(el);
          getSelection()?.removeAllRanges();
          getSelection()?.addRange(range);
        }
      }
    });
  });

  // Aftellen tot vertrek / dag van de reis
  const cd = document.querySelector<HTMLElement>('[data-countdown]');
  if (cd?.dataset.start) {
    const day = 86400000;
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const start = new Date(cd.dataset.start + 'T00:00:00');
    const end = cd.dataset.end ? new Date(cd.dataset.end + 'T00:00:00') : null;
    let text = '';
    if (today < start) {
      const n = Math.round((start.getTime() - today.getTime()) / day);
      text = n === 1 ? 'Morgen gaan we de zee op! 🌊' : `Nog <strong>${n}</strong> dagen tot vertrek`;
    } else if (!end || today <= end) {
      const n = Math.round((today.getTime() - start.getTime()) / day) + 1;
      text = `Dag <strong>${n}</strong> op zee 🌊`;
    } else {
      text = 'Weer veilig thuis! ⚓';
    }
    cd.innerHTML = text;
    cd.hidden = false;
  }

  // Bootje laten varen naar het percentage zodra het in beeld komt
  const progress = document.querySelector<HTMLElement>('[data-progress]');
  if (progress) {
    new IntersectionObserver(
      ([e], obs) => {
        if (e.isIntersecting) {
          progress.classList.add('go');
          obs.disconnect();
        }
      },
      { threshold: 0.4 },
    ).observe(progress);
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    margin-top: -72px; /* onder de doorzichtige header door */
    padding-top: 72px;
    background: linear-gradient(180deg, #a9d3e0 0%, var(--sky) 45%, var(--foam) 100%);
    overflow: hidden;
  }

  .sky {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .sun {
    position: absolute;
    top: 12%;
    right: 12%;
    width: clamp(120px, 18vw, 240px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, #fff7d6 0%, #ffe9a8 45%, rgba(255, 233, 168, 0) 70%);
    animation: glow 8s ease-in-out infinite;
  }

  @keyframes glow {
    50% {
      transform: scale(1.08);
      opacity: 0.85;
    }
  }

  .cloud {
    position: absolute;
    background: #fff;
    border-radius: 999px;
    opacity: 0.85;
    filter: blur(1px);
    animation: drift linear infinite;
  }

  .cloud::before,
  .cloud::after {
    content: '';
    position: absolute;
    background: inherit;
    border-radius: 50%;
  }

  .cloud::before {
    width: 50%;
    height: 180%;
    left: 15%;
    bottom: 20%;
  }

  .cloud::after {
    width: 35%;
    height: 140%;
    right: 15%;
    bottom: 25%;
  }

  .c1 {
    width: 160px;
    height: 40px;
    top: 18%;
    animation-duration: 90s;
    animation-delay: -20s;
  }

  .c2 {
    width: 110px;
    height: 28px;
    top: 34%;
    opacity: 0.6;
    animation-duration: 120s;
    animation-delay: -70s;
  }

  .c3 {
    width: 200px;
    height: 46px;
    top: 9%;
    opacity: 0.7;
    animation-duration: 150s;
    animation-delay: -110s;
  }

  @keyframes drift {
    from {
      transform: translateX(-250px);
    }
    to {
      transform: translateX(calc(100vw + 250px));
    }
  }

  .gulls {
    position: absolute;
    top: 14%;
    left: 0;
    width: 220px;
    animation: gulls-fly 40s linear infinite;
  }

  .gull path {
    fill: none;
    stroke: var(--navy);
    stroke-width: 2.2;
    stroke-linecap: round;
  }

  .gull {
    transform-box: fill-box;
    transform-origin: center;
    animation: flap 0.9s ease-in-out infinite;
  }

  .g2 {
    animation-delay: -0.3s;
  }

  .g3 {
    animation-delay: -0.6s;
  }

  @keyframes flap {
    50% {
      transform: scaleY(0.4) translateY(3px);
    }
  }

  @keyframes gulls-fly {
    0% {
      transform: translate(-240px, 30px);
    }
    50% {
      transform: translate(50vw, -10px);
    }
    100% {
      transform: translate(calc(100vw + 240px), 20px);
    }
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: end;
    gap: 2rem;
    padding-top: clamp(2rem, 6vw, 5rem);
  }

  .hero-text {
    padding-bottom: clamp(3rem, 8vw, 7rem);
    z-index: 2;
  }

  .eyebrow {
    display: inline-block;
    background: rgba(255, 255, 255, 0.7);
    border-radius: 999px;
    padding: 0.35em 1em;
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--sea);
    margin: 0 0 1rem;
  }

  h1 {
    margin: 0;
    line-height: 1;
  }

  h1 .script {
    display: block;
    font-size: clamp(4.5rem, 13vw, 9rem);
    color: var(--navy);
    text-shadow: 0 4px 0 rgba(255, 255, 255, 0.6);
  }

  .at-sea {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-size: clamp(1.2rem, 3vw, 1.9rem);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--navy);
    margin-top: 0.4rem;
  }

  .at-sea::before,
  .at-sea::after {
    content: '';
    width: 2.2em;
    height: 3px;
    border-radius: 3px;
    background: var(--navy);
  }

  .tagline {
    font-size: clamp(1.2rem, 2.2vw, 1.45rem);
    font-weight: 800;
    color: var(--navy);
    margin: 1.5rem 0 0.75rem;
  }

  .intro {
    max-width: 34rem;
    margin: 0 0 1.75rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .countdown {
    margin: 1.5rem 0 0;
    font-weight: 700;
    color: var(--navy);
  }

  .countdown :global(strong) {
    font-size: 1.4em;
    color: var(--sea);
  }

  .hero-ship {
    position: relative;
    align-self: end;
    margin-bottom: calc(-1 * clamp(10px, 2vw, 30px));
    z-index: 1;
  }

  .ship {
    display: block;
    width: 100%;
    transform-origin: 50% 90%;
    animation: rock 6s ease-in-out infinite;
  }

  @keyframes rock {
    0%,
    100% {
      transform: translateY(0) rotate(-1.5deg);
    }
    50% {
      transform: translateY(-10px) rotate(1.5deg);
    }
  }

  .hero :global(.hero-waves) {
    margin-top: calc(-1 * clamp(55px, 8vw, 110px));
    z-index: 3;
  }

  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-text {
      padding-bottom: 0;
      text-align: center;
    }

    .intro {
      margin-inline: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-ship {
      max-width: 480px;
      margin-inline: auto;
      width: 100%;
    }
  }

  /* ---------- Over mij ---------- */
  .about-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .about-text h2 {
    font-weight: 400;
  }

  .about-logo img {
    display: block;
    max-width: 380px;
    margin-inline: auto;
    animation: float 7s ease-in-out infinite;
    filter: drop-shadow(0 18px 24px rgba(15, 45, 69, 0.25));
  }

  @keyframes float {
    50% {
      transform: translateY(-14px) rotate(2deg);
    }
  }

  @media (max-width: 820px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-logo {
      order: -1;
    }

    .about-logo img {
      max-width: 240px;
    }
  }

  /* ---------- De reis ---------- */
  .journey {
    background: var(--foam);
    padding-top: 0;
  }

  .wave-top {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .journey :global(.wave-top),
  .donate :global(.wave-top) {
    background: var(--white);
  }

  .journey :global(.wave-top) {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .journey-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.5rem;
  }

  .journey-card {
    text-align: center;
    transition:
      opacity 0.8s ease,
      transform 0.8s ease,
      box-shadow 0.3s ease;
  }

  .journey-card:hover {
    box-shadow: 0 18px 40px -14px rgba(15, 45, 69, 0.45);
  }

  .journey-icon {
    width: 84px;
    height: 84px;
    margin: 0 auto 1rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--white);
    background: linear-gradient(145deg, var(--sea-2), var(--navy-2));
    transition: transform 0.5s ease;
  }

  .journey-card:hover .journey-icon {
    transform: rotate(-12deg) scale(1.06);
  }

  .journey-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.4rem;
  }

  .journey-card p {
    margin: 0;
    color: var(--muted);
  }

  /* ---------- Doneren ---------- */
  .donate {
    background: var(--navy);
    color: #e3f0f5;
    padding-top: 0;
    padding-bottom: 0;
  }

  .donate :global(.wave-top) {
    background: var(--foam);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .donate :global(.wave-bottom) {
    background: var(--white);
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .section-title.light h2 {
    color: #fff;
  }

  .section-title.light .prose,
  .section-title.light .prose :global(p) {
    max-width: 640px;
    margin-inline: auto;
    color: #d9eaf1;
    font-size: 1.15rem;
  }

  .progress {
    max-width: 760px;
    margin: 0 auto 3rem;
  }

  .progress-labels {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }

  .progress-labels strong {
    color: #fff;
    font-size: 1.2em;
  }

  .track {
    position: relative;
    height: 18px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    margin-top: 48px;
  }

  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    border-radius: inherit;
    background: repeating-linear-gradient(-45deg, var(--sea-2) 0 12px, var(--sea) 12px 24px);
    background-size: 34px 34px;
    animation: stripes 1.2s linear infinite;
    transition: width 2.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  @keyframes stripes {
    to {
      background-position: 34px 0;
    }
  }

  .boat {
    position: absolute;
    bottom: 6px;
    left: 0;
    width: 52px;
    transform: translateX(-50%);
    transition: left 2.4s cubic-bezier(0.25, 0.8, 0.25, 1);
    animation: bob-boat 2.6s ease-in-out infinite;
  }

  @keyframes bob-boat {
    50% {
      bottom: 10px;
      rotate: 4deg;
    }
  }

  .progress.go .fill {
    width: calc(var(--pct) * 1%);
  }

  .progress.go .boat {
    left: calc(var(--pct) * 1%);
  }

  .no-js .fill {
    width: calc(var(--pct) * 1%);
  }

  .no-js .boat {
    left: calc(var(--pct) * 1%);
  }

  .pct {
    text-align: center;
    margin: 0.75rem 0 0;
    font-weight: 700;
  }

  .donate-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 1.75rem;
    align-items: start;
  }

  .donate .card {
    color: var(--text);
  }

  .bank h3,
  .plank h3 {
    font-size: 1.5rem;
  }

  .iban-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    background: var(--foam);
    border: 2px dashed var(--sea-2);
    border-radius: 14px;
    padding: 1rem 1.1rem;
    margin: 0.5rem 0 1.25rem;
