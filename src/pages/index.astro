---
import Layout from '../layouts/Layout.astro';
import Waves from '../components/Waves.astro';
import Icon from '../components/Icon.astro';
import NewsCard from '../components/NewsCard.astro';
import RouteMap from '../components/RouteMap.astro';
import Progress from '../components/Progress.astro';
import ClubPortholes from '../components/ClubPortholes.astro';
import SponsorLogos from '../components/SponsorLogos.astro';
import Countdown from '../components/Countdown.astro';
import site from '../data/site.json';
import home from '../data/home.json';
import over from '../data/over-mij.json';
import reis from '../data/de-reis.json';
import sponsor from '../data/sponsor-mij.json';
import sponsorData from '../data/sponsors.json';
import { getNews, slugify, u, fixHtml } from '../lib/utils';

const news = (await getNews()).slice(0, 3);
const hasSponsors = (sponsorData.sponsors ?? []).some((s) => s && (s.naam || s.logo));
---

<Layout>
  <!-- ============ MIJN DROOM ============ -->
  <section class="hero">
    <div class="sky" aria-hidden="true">
      <div class="sun"></div>
      <div class="cloud c1"></div>
      <div class="cloud c2"></div>
      <div class="cloud c3"></div>
      <svg class="gulls" viewBox="0 0 200 80">
        <g class="gull g1"><path d="M0 10 Q 8 0 16 10 Q 24 0 32 10"></path></g>
        <g class="gull g2"><path d="M60 30 Q 66 22 72 30 Q 78 22 84 30"></path></g>
        <g class="gull g3"><path d="M120 6 Q 125 0 130 6 Q 135 0 140 6"></path></g>
      </svg>
    </div>

    <div class="container hero-grid">
      <div class="hero-text">
        {home.heroLabel && <p class="eyebrow">{home.heroLabel}</p>}
        <h1 class="script">{home.heroTitel}</h1>
        <p class="lead">{home.heroLead}</p>
        <div class="prose hero-prose" set:html={fixHtml(home.heroTekst)} />
        <div class="hero-actions">
          <a href={u('/sponsor-mij/')} class="btn btn-primary">
            <Icon name="hart" size={22} />
            {home.heroKnopSponsor}
          </a>
          <a href={u('/de-reis/')} class="btn btn-ghost">{home.heroKnopReis}</a>
        </div>
      </div>

      <div class="hero-ship">
        <img
          class="ship"
          src={u('/images/thalassa.webp')}
          alt={`Tekening van de ${site.schip}, het zeilschip waarmee ik de reis maak`}
          width="1400"
          height="1058"
          fetchpriority="high"
        />
      </div>
    </div>

    <Waves
      class="hero-waves"
      colors={['rgba(74,143,184,0.45)', 'rgba(42,109,151,0.5)', 'rgba(23,61,92,0.55)', '#ffffff']}
      height="clamp(80px, 13vw, 180px)"
    />
  </section>

  <!-- ============ CIJFERS ============ -->
  {
    home.cijfers?.length > 0 && (
      <section class="stats" aria-label="De reis in cijfers">
        <div class="container stats-grid">
          {home.cijfers.map((c, i) => (
            <div class="stat" data-reveal style={`transition-delay:${i * 100}ms`}>
              <span class="stat-num">{c.getal}</span>
              <span class="stat-label">{c.label}</span>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- ============ WAAROM ============ -->
  <section id="waarom" class="section why">
    <div class="container">
      <div class="section-title" data-reveal>
        <h2>{home.waaromTitel}</h2>
        {home.waaromIntro && <div class="prose why-intro" set:html={fixHtml(home.waaromIntro)} />}
      </div>
      <ul class="why-grid">
        {
          home.waaromPunten.map((p, i) => (
            <li class="card why-card" data-reveal style={`transition-delay:${(i % 3) * 100}ms`}>
              <span class="why-icon">
                <Icon name={p.icoon} size={32} />
              </span>
              <p>{p.tekst}</p>
            </li>
          ))
        }
      </ul>
      {home.waaromAfsluiting && <blockquote class="why-quote" data-reveal>{home.waaromAfsluiting}</blockquote>}
    </div>
  </section>

  <!-- ============ OVER MIJ ============ -->
  <section id="over" class="section about">
    <Waves
      class="wave-top"
      colors={['rgba(193,223,230,0.5)', 'rgba(193,223,230,0.7)', 'rgba(234,245,248,0.9)', '#eaf5f8']}
      height="clamp(40px, 6vw, 80px)"
    />
    <div class="container about-grid">
      <div class="polaroid" data-reveal>
        <img
          src={u(over.foto || '/images/logo-marit-at-sea.webp')}
          alt="Marit"
          loading="lazy"
          width="1050"
          height="1400"
        />
      </div>
      <div data-reveal>
        <h2 class="script">{over.titel}</h2>
        <p>{over.samenvatting}</p>
        {
          over.weetjes?.length > 0 && (
            <ul class="chips">
              {over.weetjes.map((w) => (
                <li>
                  <span aria-hidden="true">{w.emoji}</span> {w.tekst}
                </li>
              ))}
            </ul>
          )
        }
        <a href={u('/over-mij/')} class="btn btn-primary">{home.overKnop} →</a>
      </div>
    </div>
  </section>

  <!-- ============ DE REIS ============ -->
  <section id="reis" class="section journey">
    <div class="container">
      <div class="section-title" data-reveal>
        <h2>{reis.titel}</h2>
        <p>{reis.intro}</p>
      </div>

      <div class="journey-countdown" data-reveal>
        <Countdown />
      </div>

      <div class="journey-layout">
        <RouteMap voetnoot={reis.kaartVoetnoot} />
        <ul class="journey-list">
          {
            reis.onderdelen.map((o, i) => (
              <li data-reveal style={`transition-delay:${i * 80}ms`}>
                <a href={u(`/de-reis/#${slugify(o.titel)}`)}>
                  <span class="j-icon">
                    <Icon name={o.icoon} size={28} />
                  </span>
                  <span>
                    <strong>{o.titel}</strong>
                    <small>{o.samenvatting}</small>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <p class="center actions">
        <a href={u('/de-reis/')} class="btn btn-primary">{home.reisKnop} →</a>
        {
          site.schipVolgenUrl && (
            <a href={site.schipVolgenUrl} class="btn btn-ghost" target="_blank" rel="noopener">
              📍 Volg de {site.schip}
            </a>
          )
        }
      </p>
    </div>
  </section>

  <!-- ============ SPONSOR MIJ ============ -->
  <section id="sponsor" class="section donate">
    <Waves
      class="wave-top"
      colors={['rgba(42,109,151,0.35)', 'rgba(42,109,151,0.55)', 'rgba(23,61,92,0.8)', '#0f2d45']}
      height="clamp(50px, 8vw, 110px)"
    />
    <div class="container">
      <div class="donate-intro">
        <div data-reveal>
          <h2 class="script">{sponsor.titel}</h2>
          <div class="prose" set:html={fixHtml(sponsor.intro)} />
        </div>
        {
          sponsor.foto && (
            <div class="donate-photo" data-reveal>
              <img src={u(sponsor.foto)} alt={`Marit aan boord van de ${site.schip}`} loading="lazy" width="1200" height="1600" />
            </div>
          )
        }
      </div>

      <Progress />

      <div class="options">
        <article class="card option" data-reveal>
          <span class="opt-icon"><Icon name="hart" size={30} /></span>
          <h3>{sponsor.gofundmeTitel}</h3>
          <p>{sponsor.gofundmeSamenvatting}</p>
          {
            site.gofundmeUrl ? (
              <a href={site.gofundmeUrl} class="btn btn-primary" target="_blank" rel="noopener">
                {sponsor.gofundmeKnop}
              </a>
            ) : (
              <span class="soon">Link volgt binnenkort</span>
            )
          }
        </article>

        <article class="card option featured" data-reveal style="transition-delay:100ms">
          <span class="ribbon">Borrelplank!</span>
          <span class="opt-icon"><Icon name="vrienden" size={30} /></span>
          <h3>{sponsor.clubTitel}</h3>
          <p>{sponsor.clubSamenvatting}</p>
          <ClubPortholes />
          <a href={u('/sponsor-mij/#club-van-100')} class="btn btn-primary">Word lid</a>
        </article>

        <article class="card option" data-reveal style="transition-delay:200ms">
          <span class="opt-icon"><Icon name="vlag" size={30} /></span>
          <h3>{sponsor.zakelijkTitel}</h3>
          <p>{sponsor.zakelijkSamenvatting}</p>
          <a href={u('/sponsor-mij/#zakelijk')} class="btn btn-primary">Meer lezen</a>
        </article>
      </div>

      <p class="center">
        <a href={u('/sponsor-mij/')} class="btn btn-light">{home.sponsorKnop} →</a>
      </p>
    </div>
    <Waves
      flip
      colors={['rgba(42,109,151,0.35)', 'rgba(42,109,151,0.55)', 'rgba(23,61,92,0.8)', '#0f2d45']}
      height="clamp(50px, 8vw, 110px)"
      class="wave-bottom"
    />
  </section>

  <!-- ============ SPONSORLOGO'S ============ -->
  {
    hasSponsors && (
      <section id="sponsoren" class="section">
        <div class="container">
          <div class="section-title" data-reveal>
            <h2>{home.sponsorsTitel}</h2>
            <p>{home.sponsorsTekst}</p>
          </div>
          <SponsorLogos />
        </div>
      </section>
    )
  }

  <!-- ============ NIEUWS ============ -->
  {
    news.length > 0 && (
      <section class="section latest">
        <div class="container">
          <div class="section-title" data-reveal>
            <h2>{home.nieuwsTitel}</h2>
            {home.nieuwsSubtitel && <p>{home.nieuwsSubtitel}</p>}
          </div>
          <div class="news-grid">
            {news.map((post) => (
              <NewsCard post={post} />
            ))}
          </div>
          <p class="center">
            <a href={u('/nieuws/')} class="btn btn-ghost">
              Alle berichten
            </a>
          </p>
        </div>
      </section>
    )
  }
</Layout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    margin-top: -72px;
    padding-top: 72px;
    background: linear-gradient(180deg, #a9d3e0 0%, var(--sky) 45%, var(--foam) 100%);
    overflow: hidden;
  }

  .sky {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .sun {
    position: absolute;
    top: 10%;
    right: 12%;
    width: clamp(120px, 18vw, 240px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, #fff7d6 0%, #ffe9a8 45%, rgba(255, 233, 168, 0) 70%);
    animation: glow 8s ease-in-out infinite;
  }

  @keyframes glow {
    50% {
      transform: scale(1.08);
      opacity: 0.85;
    }
  }

  .cloud {
    position: absolute;
    background: #fff;
    border-radius: 999px;
    opacity: 0.85;
    filter: blur(1px);
    animation: drift linear infinite;
  }

  .cloud::before,
  .cloud::after {
    content: '';
    position: absolute;
    background: inherit;
    border-radius: 50%;
  }

  .cloud::before {
    width: 50%;
    height: 180%;
    left: 15%;
    bottom: 20%;
  }

  .cloud::after {
    width: 35%;
    height: 140%;
    right: 15%;
    bottom: 25%;
  }

  .c1 {
    width: 160px;
    height: 40px;
    top: 18%;
    animation-duration: 90s;
    animation-delay: -20s;
  }

  .c2 {
    width: 110px;
    height: 28px;
    top: 34%;
    opacity: 0.6;
    animation-duration: 120s;
    animation-delay: -70s;
  }

  .c3 {
    width: 200px;
    height: 46px;
    top: 9%;
    opacity: 0.7;
    animation-duration: 150s;
    animation-delay: -110s;
  }

  @keyframes drift {
    from {
      transform: translateX(-250px);
    }
    to {
      transform: translateX(calc(100vw + 250px));
    }
  }

  .gulls {
    position: absolute;
    top: 14%;
    left: 0;
    width: 220px;
    animation: gulls-fly 40s linear infinite;
  }

  .gull path {
    fill: none;
    stroke: var(--navy);
    stroke-width: 2.2;
    stroke-linecap: round;
  }

  .gull {
    transform-box: fill-box;
    transform-origin: center;
    animation: flap 0.9s ease-in-out infinite;
  }

  .g2 {
    animation-delay: -0.3s;
  }

  .g3 {
    animation-delay: -0.6s;
  }

  @keyframes flap {
    50% {
      transform: scaleY(0.4) translateY(3px);
    }
  }

  @keyframes gulls-fly {
    0% {
      transform: translate(-240px, 30px);
    }
    50% {
      transform: translate(50vw, -10px);
    }
    100% {
      transform: translate(calc(100vw + 240px), 20px);
    }
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: end;
    gap: 2rem;
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  .hero-text {
    padding-bottom: clamp(3rem, 8vw, 7rem);
    z-index: 2;
  }

  .eyebrow {
    display: inline-block;
    background: rgba(255, 255, 255, 0.7);
    border-radius: 999px;
    padding: 0.35em 1em;
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--sea);
    margin: 0 0 0.75rem;
  }

  h1 {
    font-size: clamp(3.8rem, 10vw, 7rem);
    font-weight: 400;
    line-height: 1.05;
    margin: 0;
    color: var(--navy);
    text-shadow: 0 4px 0 rgba(255, 255, 255, 0.6);
  }

  .lead {
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    font-weight: 800;
    color: var(--navy);
    margin: 1rem 0 0.75rem;
  }

  .hero-prose {
    max-width: 36rem;
    margin-bottom: 1.75rem;
  }

  .hero-prose :global(p) {
    margin: 0 0 0.8em;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-ship {
    position: relative;
    align-self: end;
    margin-bottom: calc(-1 * clamp(10px, 2vw, 30px));
    z-index: 1;
  }

  .ship {
    display: block;
    width: 100%;
    transform-origin: 50% 90%;
    animation: rock 6s ease-in-out infinite;
  }

  @keyframes rock {
    0%,
    100% {
      transform: translateY(0) rotate(-1.5deg);
    }
    50% {
      transform: translateY(-10px) rotate(1.5deg);
    }
  }

  .hero :global(.hero-waves) {
    margin-top: calc(-1 * clamp(55px, 8vw, 110px));
    z-index: 3;
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-text {
      padding-bottom: 0;
    }

    .hero-ship {
      max-width: 480px;
      margin-inline: auto;
      width: 100%;
    }
  }

  /* ---------- Cijfers ---------- */
  .stats {
    padding: 1rem 0 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
    text-align: center;
  }

  .stat {
    display: flex;
    flex-direction: column;
    padding: 1rem;
  }

  .stat-num {
    font-family: var(--font-script);
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    line-height: 1.1;
    color: var(--sea);
  }

  .stat-label {
    font-weight: 700;
    color: var(--navy);
  }

  /* ---------- Waarom ---------- */
  .why-intro {
    max-width: 760px;
    margin: 0 auto;
    color: var(--text);
    font-size: 1.1rem;
  }

  .why-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .why-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.4rem;
    transition:
      opacity 0.8s ease,
      transform 0.8s ease,
      box-shadow 0.3s ease;
  }

  .why-card:hover {
    box-shadow: 0 18px 40px -14px rgba(15, 45, 69, 0.45);
  }

  .why-icon {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #fff;
    background: linear-gradient(145deg, var(--sea-2), var(--navy-2));
    transition: transform 0.5s ease;
  }

  .why-card:hover .why-icon {
    transform: rotate(-14deg) scale(1.06);
  }

  .why-card p {
    margin: 0;
  }

  .why-quote {
    position: relative;
    max-width: 820px;
    margin: 3rem auto 0;
    padding: 1.75rem 2rem 1.75rem 4.25rem;
    background: var(--foam);
    border-radius: var(--radius);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--navy);
  }

  .why-quote::before {
    content: '“';
    position: absolute;
    left: 1.25rem;
    top: 0.2rem;
    font-family: var(--font-script);
    font-size: 5rem;
    line-height: 1;
    color: var(--sea-2);
  }

  /* ---------- Over mij ---------- */
  .about {
    background: var(--foam);
    padding-top: 0;
  }

  .about :global(.wave-top) {
    background: var(--white);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(240px, 0.8fr) 1.2fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .about h2 {
    font-weight: 400;
  }

  .polaroid {
    background: #fff;
    padding: 0.9rem 0.9rem 3rem;
    border-radius: 6px;
    box-shadow: var(--shadow);
    rotate: -3deg;
    max-width: 380px;
    margin-inline: auto;
    transition: rotate 0.5s ease;
  }

  .polaroid:hover {
    rotate: 0deg;
  }

  .polaroid img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 3px;
  }

  .chips {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chips li {
    background: #fff;
    border-radius: 999px;
    padding: 0.35em 0.9em;
    font-weight: 700;
    font-size: 0.95rem;
    box-shadow: 0 4px 12px -6px rgba(15, 45, 69, 0.35);
  }

  @media (max-width: 760px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .polaroid {
      max-width: 260px;
    }
  }

  /* ---------- De reis ---------- */
  .journey {
    background: linear-gradient(var(--foam), var(--white));
  }

  .journey-countdown {
    display: flex;
    justify-content: center;
    margin: -0.5rem 0 2.5rem;
  }

  .journey-layout {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .journey-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }

  .journey-list a {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 0.9rem 1rem;
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 6px 18px -10px rgba(15, 45, 69, 0.35);
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease;
  }

  .journey-list a:hover {
    transform: translateX(6px);
  }

  .j-icon {
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--foam);
    color: var(--sea);
  }

  .journey-list strong {
    display: block;
    color: var(--navy);
  }

  .journey-list small {
    display: block;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  @media (max-width: 900px) {
    .journey-layout {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Sponsor mij ---------- */
  .donate {
    background: var(--navy);
    color: #e3f0f5;
    padding-top: 0;
    padding-bottom: 0;
  }

  .donate :global(.wave-top) {
    background: var(--white);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .donate :global(.wave-bottom) {
    background: var(--white);
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .donate-intro {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    margin-bottom: 3rem;
  }

  .donate h2 {
    color: #fff;
    font-weight: 400;
  }

  .donate .prose {
    font-size: 1.1rem;
  }

  .donate .prose :global(strong) {
    color: #fff;
  }

  .donate-photo img {
    display: block;
    width: 100%;
    max-width: 360px;
    margin-inline: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 200px 200px var(--radius) var(--radius);
    border: 6px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 24px 50px -20px rgba(0, 0, 0, 0.6);
  }

  @media (max-width: 760px) {
    .donate-intro {
      grid-template-columns: 1fr;
    }

    .donate-photo img {
      max-width: 280px;
    }
  }

  .options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 1.5rem;
    align-items: stretch;
  }

  .option {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    color: var(--text);
    overflow: hidden;
  }

